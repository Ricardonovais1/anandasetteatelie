# Cabeçalhos do Cloudflare Pages.
# Regras mais específicas primeiro; /* se aplica a todo o resto.

# Os arquivos de /_next/static/ têm hash no nome: mudam de endereço a cada
# build, então podem ser guardados para sempre.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Imagens e cartões de compartilhamento: um mês, revalidando em segundo plano.
/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/og/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# HTML sempre revalidado, para uma correção de preço entrar no ar na hora.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
